{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/product.html",
      "destination": "/product/",
      "permanent": true
    },
    {
      "source": "/solutions.html",
      "destination": "/solutions/",
      "permanent": true
    },
    {
      "source": "/cases.html",
      "destination": "/cases/",
      "permanent": true
    },
    {
      "source": "/resources.html",
      "destination": "/resources/",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/diagnosis.html",
      "destination": "/diagnosis/",
      "permanent": true
    },
    {
      "source": "/trial.html",
      "destination": "/diagnosis/",
      "permanent": true
    },
    {
      "source": "/checkup.html",
      "destination": "/diagnosis/",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about/",
      "permanent": true
    }
  ]
}