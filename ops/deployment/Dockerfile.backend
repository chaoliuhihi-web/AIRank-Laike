FROM python:3.11.15-slim-bookworm@sha256:d29f48a31a8b408ed19272ca1e7b10ebae13b240a27e862d3d4217c528e2e0c3

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONPATH=/app:/app/apps/worker:/app/apps/scheduler:/app/packages/crawler-lite/src:/app/packages/domain/src:/app/packages/evidence/src:/app/packages/outbound-security/src:/app/packages/provider-gateway/src:/app/packages/score/src:/app/packages/skills/src:/app/packages/xinghe-adapter/src

RUN groupadd --system --gid 10001 airank \
    && useradd --system --uid 10001 --gid airank --home-dir /var/lib/airank --create-home airank

WORKDIR /app

ARG APT_MIRROR=
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PLAYWRIGHT_DOWNLOAD_HOST=

RUN if [ -n "${APT_MIRROR}" ]; then \
      sed -i "s|http://deb.debian.org/debian|${APT_MIRROR}|g" \
        /etc/apt/sources.list.d/debian.sources; \
    fi

COPY apps/api/requirements-prod.lock /tmp/requirements-prod.lock
RUN python -m pip install --index-url "${PIP_INDEX_URL}" --upgrade pip==26.2.1 setuptools==84.0.0 \
    && python -m pip install --index-url "${PIP_INDEX_URL}" --requirement /tmp/requirements-prod.lock
RUN if [ -n "${PLAYWRIGHT_DOWNLOAD_HOST}" ]; then \
      PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST}" python -m playwright install --with-deps chromium; \
    else \
      python -m playwright install --with-deps chromium; \
    fi
RUN chmod -R a=rX /ms-playwright \
    && python -m pip uninstall --yes pip setuptools wheel \
    && rm -rf /var/lib/apt/lists/* /tmp/requirements-prod.lock

ARG AIRANK_BUILD_COMMIT

COPY --chown=airank:airank apps/api /app/apps/api
COPY --chown=airank:airank apps/worker /app/apps/worker
COPY --chown=airank:airank apps/scheduler /app/apps/scheduler
COPY --chown=airank:airank apps/runtime_health.py /app/apps/runtime_health.py
COPY --chown=airank:airank packages /app/packages
COPY --chown=airank:airank scripts /app/scripts

ENV AIRANK_BUILD_COMMIT=${AIRANK_BUILD_COMMIT}

RUN mkdir -p /var/lib/airank/browser-profiles /var/lib/airank/browser-captures \
    && chown -R airank:airank /var/lib/airank

USER 10001:10001

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*", "--no-access-log"]
