# AIRank local development environment.
# Copy values into your local shell or process manager; do not commit real secrets.

AIRANK_ENV=local
AIRANK_DATABASE_URL=mysql+pymysql://airank:airank_dev_password@127.0.0.1:3306/airank_laike?charset=utf8mb4

# yudao is the authority for auth, tenant, permissions and model configuration.
AIRANK_AUTH_MODE=yudao
AIRANK_API_AUTH_ENFORCEMENT=required
AIRANK_SKILL_ADMIN_PERMISSION=airank:skill:admin
YUDAO_BASE_URL=http://127.0.0.1:48080
YUDAO_TENANT_ID=1
YUDAO_PERMISSION_INFO_URL=http://127.0.0.1:48080/admin-api/system/auth/get-permission-info
YUDAO_MODEL_RESOLVE_URL=http://127.0.0.1:48080/admin-api/ai/model/resolve
# Set YUDAO_BEARER_TOKEN in real deployments, or YUDAO_USERNAME/YUDAO_PASSWORD
# only for local integration tests that obtain a temporary token.
# AIRANK_DEV_PERMISSIONS is dev-only; production permissions must come from
# Yudao permission-info and client-supplied permission headers are overwritten.
# AIRANK_DEV_PERMISSIONS=airank:skill:admin

# Reviewer-directory synchronization reuses Yudao auth by default. Override
# only for a dedicated service endpoint/token; secrets stay server-side.
# YUDAO_REVIEW_DIRECTORY_BASE_URL=https://yudao.example.com
# YUDAO_REVIEW_DIRECTORY_BEARER_TOKEN=
YUDAO_REVIEW_DIRECTORY_TIMEOUT_SECONDS=5
YUDAO_REVIEW_DIRECTORY_PAGE_SIZE=100
YUDAO_REVIEW_DIRECTORY_MAX_MEMBERS=500

# Single-node beta object storage gate. Use a mounted persistent directory in
# production-like environments; `local` remains dev_only.
AIRANK_OBJECT_STORAGE_DRIVER=filesystem
AIRANK_OBJECT_STORAGE_ROOT=/var/lib/airank/objects
AIRANK_PROBE_TIMEOUT_SECONDS=3

# Multi-node production must replace the filesystem settings above with an
# S3-compatible service. Secrets belong in the deployment secret store.
# AIRANK_OBJECT_STORAGE_DRIVER=s3
# AIRANK_S3_ENDPOINT_URL=https://objects.example.com
# AIRANK_S3_BUCKET=airank-evidence
# AIRANK_S3_REGION=cn-north-1
# AIRANK_S3_ADDRESSING_STYLE=path
# AIRANK_S3_ACCESS_KEY_ID=
# AIRANK_S3_SECRET_ACCESS_KEY=
# AIRANK_S3_SESSION_TOKEN=
# AIRANK_S3_ALLOW_HTTP=false

# External AI provider scans.
# Production ranking must use consumer web pages through browser automation,
# not model APIs. Use AIRANK_PROVIDER_MODE=mock only for local contract tests
# or static UI development; never enable it in staging or production.
AIRANK_PROVIDER_MODE=browser
AIRANK_PROVIDER_MAX_ATTEMPTS=3
AIRANK_PROVIDER_TIMEOUT_SECONDS=90
AIRANK_PROVIDER_QPS=2
AIRANK_PROVIDER_CONCURRENCY=2
# MySQL-backed safety state. Override per provider with e.g.
# QIANWEN_QUOTA_UNITS; units are reservations per UTC day.
AIRANK_PROVIDER_DEFAULT_QUOTA_UNITS=1000000
AIRANK_PROVIDER_QUOTA_RESERVATION_TTL_SECONDS=300
AIRANK_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AIRANK_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
AIRANK_BROWSER_HEADLESS=1
AIRANK_BROWSER_TIMEOUT_SECONDS=90
AIRANK_BROWSER_PROFILE_DIR=.runtime/browser-profiles
AIRANK_BROWSER_CAPTURE_DIR=.runtime/browser-captures
# Use the installed production browser when provider sites block Playwright's
# bundled test browser. Set either AIRANK_BROWSER_CHANNEL=chrome or an explicit
# executable path supported by the deployment host.
# AIRANK_BROWSER_CHANNEL=chrome
# AIRANK_BROWSER_EXECUTABLE_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Production browser mode defaults to all providers in scope. Override only for
# an explicitly documented partial-beta release.
AIRANK_MIN_PROVIDER_SUCCESS_COUNT=7

# Consumer web URLs. Override only when a provider changes its public entry.
AIRANK_CHATGPT_WEB_URL=https://chatgpt.com/
AIRANK_DEEPSEEK_WEB_URL=https://chat.deepseek.com/
AIRANK_KIMI_WEB_URL=https://www.kimi.com/
AIRANK_TONGYI_WEB_URL=https://www.tongyi.com/qianwen/
AIRANK_DOUBAO_WEB_URL=https://www.doubao.com/chat/
AIRANK_BAIDU_AI_SEARCH_WEB_URL=https://chat.baidu.com/
AIRANK_YUANBAO_WEB_URL=https://yuanbao.tencent.com/

# Governed external publisher. Hosts must be exact comma-separated HTTPS
# destination/receipt hosts. Keep credentials in the process secret store.
# AIRANK_PUBLISH_ALLOWED_HOSTS=www.example.com,publisher.example.com
AIRANK_PUBLISH_TIMEOUT_SECONDS=30
AIRANK_PUBLISH_MAX_RESPONSE_BYTES=1000000
AIRANK_PAGE_AUDIT_TIMEOUT_SECONDS=20
AIRANK_PAGE_AUDIT_MAX_RESPONSE_BYTES=2000000
AIRANK_PUBLISH_ATTEMPT_STALE_SECONDS=600
# AIRANK_PUBLISH_HTTP_BEARER_TOKEN=
# AIRANK_WORDPRESS_USERNAME=
# AIRANK_WORDPRESS_APP_PASSWORD=
AIRANK_WORDPRESS_POST_STATUS=draft

# Reviewer-SLA notification Consumer. A successful immutable receipt is
# required before the UI reports external delivery as verified.
# AIRANK_REVIEW_NOTIFICATION_WEBHOOK_URL=https://notify.example.com/airank/review
# AIRANK_REVIEW_NOTIFICATION_BEARER_TOKEN=
AIRANK_REVIEW_NOTIFICATION_TIMEOUT_SECONDS=10
AIRANK_REVIEW_NOTIFICATION_MAX_ATTEMPTS=3

# XingheAI2026V2 capabilities are optional enhancers. AIRank must keep fallbacks.
XINGHE_CAPABILITY_MODE=adapter
XINGHE_CRAWLER_GATEWAY_BASE_URL=http://127.0.0.1:8000
XINGHE_KB_SERVICE_BASE_URL=http://127.0.0.1:8010
XINGHE_CREATOR_MARKETING_BASE_URL=http://127.0.0.1:8020
XINGHE_WORKFLOW_RUNNER_BASE_URL=http://127.0.0.1:8030

# Worker.
AIRANK_WORKER_ID=local-worker-1
AIRANK_WORKER_POLL_SECONDS=3
AIRANK_WORKER_MAX_ATTEMPTS=3
# A global worker requires this plus `--allow-global-scope`.
AIRANK_WORKER_GLOBAL_SCOPE_ENABLED=false
AIRANK_WORKER_TENANT_ID=
AIRANK_WORKER_PROJECT_ID=
AIRANK_WORKER_JOB_ID=

AIRANK_SCHEDULER_ID=local-retest-scheduler-1
AIRANK_SCHEDULER_GLOBAL_SCOPE_ENABLED=false
AIRANK_SCHEDULER_TENANT_ID=
AIRANK_SCHEDULER_PROJECT_ID=
AIRANK_SCHEDULER_WINDOW_ID=
