# AIRank local development environment.
# Copy values into your local shell or process manager; do not commit real secrets.

AIRANK_ENV=local
AIRANK_DATABASE_URL=mysql+pymysql://airank:airank_dev_password@127.0.0.1:3306/airank_laike?charset=utf8mb4

# yudao is the authority for auth, tenant, permissions and model configuration.
AIRANK_AUTH_MODE=yudao
YUDAO_BASE_URL=http://127.0.0.1:48080
YUDAO_PERMISSION_INFO_URL=http://127.0.0.1:48080/admin-api/system/auth/get-permission-info
YUDAO_MODEL_RESOLVE_URL=http://127.0.0.1:48080/admin-api/ai/model/resolve

# XingheAI2026V2 capabilities are optional enhancers. AIRank must keep fallbacks.
XINGHE_CAPABILITY_MODE=adapter
XINGHE_CRAWLER_GATEWAY_BASE_URL=http://127.0.0.1:8000
XINGHE_KB_SERVICE_BASE_URL=http://127.0.0.1:8010
XINGHE_CREATOR_MARKETING_BASE_URL=http://127.0.0.1:8020
XINGHE_WORKFLOW_RUNNER_BASE_URL=http://127.0.0.1:8030

# Object storage for snapshots, evidence bundles and reports.
AIRANK_OBJECT_STORAGE_DRIVER=local
AIRANK_OBJECT_STORAGE_ROOT=.runtime/objects

# Worker.
AIRANK_WORKER_ID=local-worker-1
AIRANK_WORKER_POLL_SECONDS=3
AIRANK_WORKER_MAX_ATTEMPTS=3
