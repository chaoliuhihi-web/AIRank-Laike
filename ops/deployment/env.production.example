# Copy to ops/deployment/.env.production and inject every secret from the
# production secret manager. Never commit that file or paste secret values into
# CI logs, tickets, or chat.

AIRANK_ENV=production
AIRANK_PUBLIC_ORIGIN=https://console.airank.example.cn
AIRANK_BUILD_COMMIT=0000000000000000000000000000000000000000

# Managed MySQL 8.0+. TLS certificate path must exist inside the backend image
# or be mounted read-only by the deployment platform.
AIRANK_DATABASE_URL=mysql+pymysql://airank_app:REPLACE_ME@mysql.example.cn:3306/airank_laike?charset=utf8mb4&ssl_ca=/run/secrets/mysql-ca.pem
# Migration-only credential; do not grant CREATE/ALTER to AIRANK_DATABASE_URL.
AIRANK_MIGRATION_DATABASE_URL=mysql+pymysql://airank_migrator:REPLACE_ME@mysql.example.cn:3306/airank_laike?charset=utf8mb4&ssl_ca=/run/secrets/mysql-ca.pem
AIRANK_DATABASE_TLS_VERIFY_MODE=identity
# Exact cloud snapshot/backup job receipt confirmed restorable before deploy.
AIRANK_DATABASE_BACKUP_RECEIPT=REPLACE_ME

AIRANK_AUTH_MODE=yudao
AIRANK_API_AUTH_ENFORCEMENT=required
AIRANK_TENANT_RESOLUTION_MODE=database
# First release tenant used by launch gates; it must already exist as one active
# row in airank_tenant_bindings.
AIRANK_RELEASE_TENANT_ID=tenant_customer_a
AIRANK_RELEASE_YUDAO_TENANT_ID=1008
AIRANK_SKILL_ADMIN_PERMISSION=airank:skill:admin
AIRANK_PROVIDER_ADMIN_PERMISSION=airank:provider:admin
AIRANK_PROVIDER_PLATFORM_ADMIN_PERMISSION=airank:provider:platform-admin
YUDAO_BASE_URL=https://yudao.example.cn
YUDAO_PERMISSION_INFO_URL=https://yudao.example.cn/admin-api/system/auth/get-permission-info
YUDAO_MODEL_RESOLVE_URL=https://yudao.example.cn/admin-api/ai/model/resolve
YUDAO_REVIEW_DIRECTORY_TIMEOUT_SECONDS=5
YUDAO_REVIEW_DIRECTORY_PAGE_SIZE=100
YUDAO_REVIEW_DIRECTORY_MAX_MEMBERS=500
# YUDAO_BEARER_TOKEN=secret-manager-only

AIRANK_OBJECT_STORAGE_DRIVER=s3
AIRANK_S3_ENDPOINT_URL=https://objects.example.cn
AIRANK_S3_BUCKET=airank-production-evidence
AIRANK_S3_REGION=cn-north-1
AIRANK_S3_ADDRESSING_STYLE=path
AIRANK_S3_ALLOW_HTTP=false
AIRANK_S3_TIMEOUT_SECONDS=10
# The release gate writes and reads one immutable readiness sentinel. Keep false
# in normal runtime and set true only for an authorized release verification.
AIRANK_RELEASE_RUN_STORAGE_PROBE=false
# AIRANK_S3_ACCESS_KEY_ID=secret-manager-only
# AIRANK_S3_SECRET_ACCESS_KEY=secret-manager-only
# AIRANK_S3_SESSION_TOKEN=secret-manager-only

# Each JSON map value is a different Base64-encoded 32-byte random key.
AIRANK_CREDENTIAL_ACTIVE_ENCRYPTION_KEY_ID=enc-2026-08
AIRANK_CREDENTIAL_ENCRYPTION_KEYS={"enc-2026-08":"REPLACE_ME"}
AIRANK_CREDENTIAL_ACTIVE_FINGERPRINT_KEY_ID=fp-2026-08
AIRANK_CREDENTIAL_FINGERPRINT_KEYS={"fp-2026-08":"REPLACE_ME"}
AIRANK_CREDENTIAL_VERIFY_TIMEOUT_SECONDS=45

AIRANK_PROVIDER_MODE=api
AIRANK_SCAN_DISPATCH_MODE=worker
AIRANK_PROVIDER_MAX_ATTEMPTS=3
AIRANK_PROVIDER_TIMEOUT_SECONDS=90
AIRANK_PROVIDER_QPS=2
AIRANK_PROVIDER_CONCURRENCY=2
AIRANK_PROVIDER_DEFAULT_QUOTA_UNITS=1000000
AIRANK_PROVIDER_QUOTA_RESERVATION_TTL_SECONDS=300
AIRANK_PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
AIRANK_PROVIDER_CIRCUIT_COOLDOWN_SECONDS=30
AIRANK_ALLOW_CUSTOM_PROVIDER_ENDPOINTS=false
# Set true only after rotating every credential ever exposed outside the secret store.
AIRANK_COMPROMISED_CREDENTIALS_ROTATED=false

QIANWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QIANWEN_MODEL=qwen3.6-plus
QIANWEN_PROVIDER_DISABLED=false
# QIANWEN_API_KEY=secret-manager-only
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
DOUBAO_MODEL=doubao-seed-2-0-lite-260215
DOUBAO_PROVIDER_DISABLED=false
# DOUBAO_API_KEY=secret-manager-only
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=kimi-k3
KIMI_PROVIDER_DISABLED=false
# KIMI_API_KEY=secret-manager-only-and-rotated
DEEPSEEK_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DEEPSEEK_MODEL=REPLACE_WITH_VALIDATED_NON_SUNSETTING_MODEL
DEEPSEEK_PROVIDER_DISABLED=false
# DEEPSEEK_API_KEY=secret-manager-only

AIRANK_BROWSER_HEADLESS=1
AIRANK_BROWSER_TIMEOUT_SECONDS=90
AIRANK_BROWSER_PROFILE_DIR=/var/lib/airank/browser-profiles
AIRANK_BROWSER_CAPTURE_DIR=/var/lib/airank/browser-captures
AIRANK_MIN_PROVIDER_SUCCESS_COUNT=4

AIRANK_PUBLISH_ALLOWED_HOSTS=www.customer.example.cn
AIRANK_PUBLISH_TIMEOUT_SECONDS=30
AIRANK_PUBLISH_MAX_RESPONSE_BYTES=1000000
AIRANK_PAGE_AUDIT_TIMEOUT_SECONDS=20
AIRANK_PAGE_AUDIT_MAX_RESPONSE_BYTES=2000000
AIRANK_PUBLISH_ATTEMPT_STALE_SECONDS=600
AIRANK_WORDPRESS_POST_STATUS=draft

XINGHE_CAPABILITY_MODE=disabled

AIRANK_WORKER_ID=airank-worker-production-1
AIRANK_WORKER_POLL_SECONDS=3
AIRANK_WORKER_MAX_ATTEMPTS=3
AIRANK_WORKER_GLOBAL_SCOPE_ENABLED=true
AIRANK_SCHEDULER_ID=airank-scheduler-production-1
AIRANK_SCHEDULER_GLOBAL_SCOPE_ENABLED=true
