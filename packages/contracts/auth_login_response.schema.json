{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/auth_login_response.schema.json",
  "title": "AIRank Auth Login Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "access_token",
        "token_type",
        "expires_in",
        "tenant_id",
        "yudao_tenant_id",
        "user",
        "permissions",
        "dev_only"
      ],
      "additionalProperties": false,
      "properties": {
        "access_token": { "type": "string", "minLength": 1 },
        "token_type": { "type": "string", "const": "Bearer" },
        "expires_in": { "type": ["integer", "null"], "minimum": 1 },
        "tenant_id": { "type": "string", "minLength": 1 },
        "yudao_tenant_id": { "type": "string", "minLength": 1 },
        "user": {
          "type": "object",
          "required": ["user_id", "username", "nickname"],
          "additionalProperties": false,
          "properties": {
            "user_id": { "type": "string", "minLength": 1 },
            "username": { "type": ["string", "null"], "minLength": 1 },
            "nickname": { "type": ["string", "null"], "minLength": 1 }
          }
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "dev_only": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
