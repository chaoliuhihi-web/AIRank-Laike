{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/brand_alias_write_request.schema.json",
  "title": "AIRank Brand Alias Write Request",
  "type": "object",
  "required": ["alias_text", "alias_type", "fact_revision_id"],
  "additionalProperties": false,
  "properties": {
    "alias_text": { "type": "string", "minLength": 2, "maxLength": 255 },
    "alias_type": { "type": "string", "enum": ["official", "english", "abbreviation", "former_name", "misspelling", "product_variant"] },
    "language_code": { "type": ["string", "null"], "minLength": 2, "maxLength": 16 },
    "usage_scope": { "type": "string", "enum": ["measurement_only", "public_and_measurement"], "default": "measurement_only" },
    "fact_revision_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "status": { "type": "string", "enum": ["active", "disabled"], "default": "active" },
    "expected_version": { "type": ["integer", "null"], "minimum": 1 }
  }
}
