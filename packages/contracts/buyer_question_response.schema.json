{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/buyer_question_response.schema.json",
  "title": "AIRank Buyer Question Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "question_id",
        "project_id",
        "tenant_id",
        "question_text",
        "question_type",
        "intent_level",
        "buyer_stage",
        "recommended_providers",
        "coverage_status",
        "status",
        "source",
        "question_version_id",
        "taxonomy_version",
        "dedupe_sha256",
        "prompt_style",
        "temporal_scope",
        "scenario",
        "cohort_type",
        "source_kind",
        "source_ref",
        "evidence_level",
        "observed_query",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": { "type": "string", "pattern": "^question_[A-Za-z0-9_-]+$" },
        "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "question_text": { "type": "string", "minLength": 4, "maxLength": 500 },
        "question_type": {
          "type": "string",
          "enum": ["purchase", "compare", "select", "trust", "price", "risk", "scenario", "local", "alternative"]
        },
        "intent_level": { "type": "string", "enum": ["high", "medium", "low"] },
        "buyer_stage": { "type": "string", "enum": ["awareness", "consideration", "decision"] },
        "source_reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
        "recommended_providers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["chatgpt", "deepseek", "kimi", "qianwen", "tongyi", "doubao", "baidu_ai_search", "yuanbao", "manual_import"]
          },
          "uniqueItems": true
        },
        "coverage_status": { "type": "string", "enum": ["unknown", "covered", "gap", "needs_scan"] },
        "status": { "type": "string", "enum": ["suggested", "confirmed", "archived"] },
        "source": { "type": "string", "enum": ["hermes_generated", "manual", "imported"] },
        "question_version_id": { "type": ["string", "null"], "pattern": "^question_v_[0-9a-f]{20}$" },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "dedupe_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "prompt_style": { "type": "string", "enum": ["exploratory", "comparative", "factual", "procedural", "evaluative"] },
        "temporal_scope": { "type": "string", "enum": ["evergreen", "current", "historical"] },
        "scenario": { "type": "string", "enum": ["generic", "b2b_procurement", "local_selection", "replacement", "risk_validation"] },
        "region": { "type": ["string", "null"] },
        "cohort_type": { "type": "string", "enum": ["blind", "assisted", "comparison", "fact_verification", "unclassified"] },
        "source_kind": { "type": "string", "enum": ["provided_seed", "template_candidate", "observed_query", "imported"] },
        "source_ref": { "type": "string", "minLength": 1 },
        "evidence_level": { "type": "string", "enum": ["provided_seed", "template_candidate", "observed_query", "imported"] },
        "observed_query": { "type": "boolean" },
        "reviewed_by": { "type": ["string", "null"] },
        "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
        "review_note": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "meta": { "$ref": "#/$defs/response_meta" }
  },
  "$defs": {
    "response_meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
