{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/console_overview.schema.json",
  "title": "AIRank Console Overview",
  "type": "object",
  "required": ["project", "metric_cards", "data_status", "message"],
  "additionalProperties": false,
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "website", "industry", "competitors", "audience", "date"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "minLength": 1 },
        "website": { "type": "string" },
        "industry": { "type": "string" },
        "competitors": { "type": "string" },
        "audience": { "type": "string" },
        "date": { "type": "string", "format": "date" }
      }
    },
    "metric_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value", "suffix", "delta", "tone", "icon"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": "string", "minLength": 1 },
          "suffix": { "type": "string" },
          "delta": { "type": "string", "minLength": 1 },
          "tone": { "type": "string", "enum": ["primary", "success", "warning", "danger", "muted"] },
          "icon": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data_status": {
      "type": "string",
      "enum": ["empty", "collecting", "provider_evidence", "unverified"]
    },
    "message": { "type": "string" }
  }
}
