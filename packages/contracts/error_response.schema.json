            "CITATION_NOT_FOUND_IN_SNAPSHOT",
            "ANSWER_SNAPSHOT_NOT_FOUND",
            "CITATION_CAPTURE_NOT_FOUND",
            "CITATION_CAPTURE_URL_INVALID",
