            "FACT_REVISION_NOT_FOUND",
            "FACT_CONFLICT_NOT_FOUND",
            "FACT_CONFLICT_OPEN",
            "FACT_SUBJECT_IMMUTABLE",
            "FACT_SUBJECT_BINDING_MISMATCH",
