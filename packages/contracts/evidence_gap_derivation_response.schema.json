{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/evidence_gap_derivation_response.schema.json",
  "title": "AIRank Evidence Gap Derivation Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["derivation_run_id", "project_id", "run_id", "contract_version", "derivation_policy", "quality_report_sha256", "evidence_basis_sha256", "gap_count", "skipped_group_count", "gaps", "created_by", "created_at", "idempotent_replay"],
      "additionalProperties": false,
      "properties": {
        "derivation_run_id": { "type": "string", "pattern": "^gap_run_[0-9a-f]{20}$" },
        "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
        "run_id": { "type": "string", "pattern": "^scan_run_[A-Za-z0-9_-]+$" },
        "contract_version": { "const": "airank.evidence-gap.v2" },
        "derivation_policy": { "const": "airank.brand-unmentioned-gap.v1" },
        "quality_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "evidence_basis_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "gap_count": { "type": "integer", "minimum": 0 },
        "skipped_group_count": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/evidence_gap" } },
        "created_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "meta": { "$ref": "#/$defs/response_meta" }
  },
  "$defs": {
    "evidence_gap": {
      "type": "object",
      "required": ["gap_id", "project_id", "run_id", "gap_type", "contract_version", "derivation_policy", "severity", "title", "description", "related_question_ids", "provider", "collector_surface", "valid_sample_count", "normal_unmentioned_count", "answer_snapshot_ids", "evidence_snapshot_ids", "citation_ids", "fact_atom_ids", "suggested_asset_type", "evidence_sha256", "quality_report_sha256", "status", "created_at"],
      "additionalProperties": false,
      "properties": {
        "gap_id": { "type": "string", "pattern": "^gap_ev_[0-9a-f]{20}$" },
        "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
        "run_id": { "type": "string", "pattern": "^scan_run_[A-Za-z0-9_-]+$" },
        "gap_type": { "const": "brand_unmentioned" },
        "contract_version": { "const": "airank.evidence-gap.v2" },
        "derivation_policy": { "const": "airank.brand-unmentioned-gap.v1" },
        "severity": { "type": "string", "enum": ["low", "medium", "high"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": "string", "minLength": 1 },
        "related_question_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^question_[A-Za-z0-9_-]+$" } },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "collector_surface": { "type": "string", "enum": ["api", "web", "app", "manual_import"] },
        "valid_sample_count": { "type": "integer", "minimum": 3 },
        "normal_unmentioned_count": { "type": "integer", "minimum": 3 },
        "answer_snapshot_ids": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "evidence_snapshot_ids": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "citation_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fact_atom_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "suggested_asset_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "quality_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "type": "string", "minLength": 1, "maxLength": 32 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "response_meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
