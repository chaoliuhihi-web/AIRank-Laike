{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/evidence_integrity_audit_response.schema.json",
  "title": "AIRank Evidence Integrity Audit Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": { "$ref": "#/$defs/audit" },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "finding_id", "entity_type", "entity_id", "object_type", "status",
        "blocking", "expected_sha256", "actual_sha256", "expected_byte_size",
        "actual_byte_size", "details", "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string", "pattern": "^integrity_finding_[0-9a-f]{20}$" },
        "entity_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "entity_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "object_type": { "type": ["string", "null"], "maxLength": 64 },
        "status": {
          "enum": [
            "verified", "metadata_invalid", "unavailable", "driver_mismatch",
            "hash_mismatch", "size_mismatch", "scope_too_large"
          ]
        },
        "blocking": { "type": "boolean" },
        "expected_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "actual_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "expected_byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "actual_byte_size": { "type": ["integer", "null"], "minimum": 0 },
        "details": { "type": "object" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "audit": {
      "type": "object",
      "required": [
        "audit_id", "tenant_id", "project_id", "policy_version", "scope",
        "status", "entity_count", "verified_count", "blocking_finding_count",
        "unavailable_count", "hash_mismatch_count", "size_mismatch_count",
        "metadata_invalid_count", "manifest_sha256", "request_sha256",
        "requested_by", "trace_id", "started_at", "completed_at", "findings",
        "idempotent_replay"
      ],
      "additionalProperties": false,
      "properties": {
        "audit_id": { "type": "string", "pattern": "^integrity_audit_[0-9a-f]{20}$" },
        "tenant_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "project_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "policy_version": { "const": "airank.evidence-integrity.v1" },
        "scope": { "const": "project" },
        "status": { "enum": ["passed", "blocked", "failed"] },
        "entity_count": { "type": "integer", "minimum": 1 },
        "verified_count": { "type": "integer", "minimum": 0 },
        "blocking_finding_count": { "type": "integer", "minimum": 0 },
        "unavailable_count": { "type": "integer", "minimum": 0 },
        "hash_mismatch_count": { "type": "integer", "minimum": 0 },
        "size_mismatch_count": { "type": "integer", "minimum": 0 },
        "metadata_invalid_count": { "type": "integer", "minimum": 0 },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "request_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "requested_by": { "type": "string", "minLength": 1, "maxLength": 64 },
        "trace_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "started_at": { "type": "string", "format": "date-time" },
        "completed_at": { "type": "string", "format": "date-time" },
        "findings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/finding" } },
        "idempotent_replay": { "type": "boolean" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
