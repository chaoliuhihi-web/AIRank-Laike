{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/evidence_review_escalation_response.schema.json",
  "title": "AIRank Evidence Review SLA Escalation List Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "escalation_count",
        "pending_count",
        "published_count",
        "failed_count",
        "canceled_count",
        "escalations"
      ],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "escalation_count": { "type": "integer", "minimum": 0 },
        "pending_count": { "type": "integer", "minimum": 0 },
        "published_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "canceled_count": { "type": "integer", "minimum": 0 },
        "escalations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "event_id",
              "case_id",
              "reviewer_role",
              "due_at",
              "escalated_at",
              "overdue_seconds",
              "assignment_state",
              "routing_state",
              "routing_team_id",
              "routing_route_version",
              "eligible_recipient_count",
              "external_sync_state",
              "outbox_status",
              "external_delivery_verified",
              "delivery_channel",
              "delivery_attempt_count",
              "delivery_receipt_id",
              "provider_receipt_id",
              "delivered_at",
              "delivery_endpoint_host",
              "delivery_response_status",
              "delivery_response_sha256"
            ],
            "properties": {
              "event_id": { "type": "string", "minLength": 1 },
              "case_id": { "type": "string", "minLength": 1 },
              "reviewer_role": { "enum": ["secondary", "adjudicator"] },
              "due_at": { "type": "string", "format": "date-time" },
              "escalated_at": { "type": "string", "format": "date-time" },
              "overdue_seconds": { "type": "integer", "minimum": 0 },
              "assignment_state": { "enum": ["unassigned", "assigned", "expired"] },
              "routing_state": { "enum": ["unrestricted_legacy", "resolved", "blocked_role_unconfigured", "blocked_team_inactive", "blocked_no_recipients"] },
              "routing_team_id": { "type": ["string", "null"] },
              "routing_route_version": { "type": ["integer", "null"], "minimum": 1 },
              "eligible_recipient_count": { "type": "integer", "minimum": 0 },
              "external_sync_state": { "enum": ["not_configured", "pending", "verified", "stale", "failed"] },
              "outbox_status": { "enum": ["pending", "published", "failed", "canceled"] },
              "external_delivery_verified": { "type": "boolean" },
              "delivery_channel": { "enum": ["webhook", null] },
              "delivery_attempt_count": { "type": "integer", "minimum": 0 },
              "delivery_receipt_id": { "type": ["string", "null"] },
              "provider_receipt_id": { "type": ["string", "null"] },
              "delivered_at": { "type": ["string", "null"], "format": "date-time" },
              "delivery_endpoint_host": { "type": ["string", "null"] },
              "delivery_response_status": { "type": ["integer", "null"] },
              "delivery_response_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "request_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 }
      }
    }
  }
}
