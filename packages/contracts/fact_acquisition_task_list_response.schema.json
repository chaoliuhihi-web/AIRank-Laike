{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/fact_acquisition_task_list_response.schema.json",
  "title": "AIRank Fact Acquisition Task List Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["project_id", "contract_version", "tasks", "open_count", "in_review_count", "resolved_count"],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "contract_version": { "const": "airank.fact-acquisition-task.v1" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "open_count": { "type": "integer", "minimum": 0 },
        "in_review_count": { "type": "integer", "minimum": 0 },
        "resolved_count": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "minLength": 1 }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "task_id", "project_id", "gap_id", "contract_version", "gap_contract_version",
        "gap_evidence_sha256", "quality_report_sha256", "status", "resolution_state",
        "priority", "title", "evidence_requirement", "required_authority_policy",
        "suggested_fact_type", "related_question_ids", "provider", "collector_surface",
        "knowledge_source_ids", "fact_revision_ids", "approved_fact_revision_ids",
        "generation_allowed", "event_count", "last_event_sha256", "created_by",
        "updated_by", "version", "resolved_at", "created_at", "updated_at", "idempotent_replay"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string", "pattern": "^fact_task_[0-9a-f]{20}$" },
        "project_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gap_id": { "type": "string", "pattern": "^gap_ev_[0-9a-f]{20}$" },
        "contract_version": { "const": "airank.fact-acquisition-task.v1" },
        "gap_contract_version": { "const": "airank.evidence-gap.v2" },
        "gap_evidence_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "quality_report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["open", "in_review", "resolved", "blocked"] },
        "resolution_state": { "enum": ["needs_fact_proposal", "needs_fact_review", "ready_for_intervention", "blocked"] },
        "priority": { "enum": ["low", "medium", "high"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "evidence_requirement": { "type": "string", "minLength": 8, "maxLength": 2000 },
        "required_authority_policy": { "const": "official_or_verified_third_party.v1" },
        "suggested_fact_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "related_question_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
        "collector_surface": { "enum": ["api", "web", "app", "manual_import"] },
        "knowledge_source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "fact_revision_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "approved_fact_revision_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "generation_allowed": { "type": "boolean" },
        "event_count": { "type": "integer", "minimum": 1 },
        "last_event_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "created_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updated_by": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "resolved_at": { "type": ["string", "null"], "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "idempotent_replay": { "type": "boolean" }
      }
    }
  }
}
