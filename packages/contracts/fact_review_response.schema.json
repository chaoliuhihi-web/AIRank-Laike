{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/fact_review_response.schema.json",
  "title": "AIRank Fact Review Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "fact_id",
        "tenant_id",
        "project_id",
        "review_status",
        "fact_status",
        "disclosure",
        "trust_level",
        "reviewed_by",
        "reviewed_at",
        "source_refs"
      ],
      "additionalProperties": false,
      "properties": {
        "fact_id": { "type": "string", "pattern": "^fact_[A-Za-z0-9_-]+$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
        "review_status": { "type": "string", "enum": ["confirmed", "rejected", "needs_redaction", "private"] },
        "fact_status": { "type": "string", "enum": ["draft", "confirmed", "rejected", "stale"] },
        "disclosure": { "type": "string", "enum": ["public", "redacted", "internal", "forbidden", "pending_approval"] },
        "trust_level": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "reviewed_by": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "review_note": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        }
      }
    },
    "meta": { "$ref": "#/$defs/response_meta" }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": ["source_type", "support_type"],
      "additionalProperties": false,
      "properties": {
        "source_type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "support_type": { "type": "string", "enum": ["supports", "contradicts", "context"] },
        "citation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "snapshot_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "object_ref_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source_url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "source_title": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "response_meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
