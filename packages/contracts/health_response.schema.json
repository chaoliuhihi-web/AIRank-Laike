{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/health_response.schema.json",
  "title": "AIRank Health Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["status", "service", "api_version"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "const": "ok" },
        "service": { "type": "string", "const": "airank-api" },
        "api_version": { "type": "string", "const": "v1" }
      }
    },
    "meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
