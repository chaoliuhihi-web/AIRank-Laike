{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/measurement_quality_report_response.schema.json",
  "title": "AIRank Measurement Quality Report Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "run_id", "status", "publishable", "data_sha256", "report_sha256", "metrics", "checks", "surface_evidence", "known_limitations"],
      "properties": {
        "contract_version": { "const": "airank.measurement-quality.v2" },
        "run_id": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pass", "blocked"] },
        "publishable": { "type": "boolean" },
        "data_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "report_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "metrics": { "type": "object" },
        "checks": {
          "type": "array",
          "minItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "status", "actual", "expected", "detail"],
            "properties": {
              "code": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["pass", "blocked", "warning"] },
              "actual": {},
              "expected": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        },
        "surface_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "evidence_level", "sample_count", "valid_sample_count", "evidence_complete_count", "screenshot_count", "source_panel_captured_count", "source_panel_not_present_count", "blocker_count"],
            "properties": {
              "surface": { "type": "string", "enum": ["api", "web", "app", "manual_import"] },
              "evidence_level": { "type": "string", "enum": ["provider_api", "consumer_web", "consumer_app", "manual_import"] },
              "sample_count": { "type": "integer", "minimum": 0 },
              "valid_sample_count": { "type": "integer", "minimum": 0 },
              "evidence_complete_count": { "type": "integer", "minimum": 0 },
              "screenshot_count": { "type": "integer", "minimum": 0 },
              "source_panel_captured_count": { "type": "integer", "minimum": 0 },
              "source_panel_not_present_count": { "type": "integer", "minimum": 0 },
              "blocker_count": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "known_limitations": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "request_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
