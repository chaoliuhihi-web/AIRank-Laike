{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_action.schema.json",
  "title": "AIRank Governed Opportunity Action",
  "type": "object",
  "required": ["action_id", "project_id", "opportunity_id", "contract_version", "source_kind", "action_type", "status", "source_snapshot_id", "source_derivation_run_id", "source_snapshot_sha256", "source_evidence_sha256", "latest_snapshot_id", "latest_derivation_run_id", "latest_snapshot_sha256", "latest_evidence_sha256", "assigned_to", "assigned_at", "due_at", "sla_state", "action_note", "verification_run_id", "verification_basis_sha256", "closure_reason", "effect_claim_allowed", "event_count", "last_event_sha256", "created_by", "updated_by", "version", "completed_at", "created_at", "updated_at", "idempotent_replay"],
  "additionalProperties": false,
  "properties": {
    "action_id": { "type": "string", "pattern": "^opportunity_action_[0-9a-f]{20}$" },
    "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
    "opportunity_id": { "type": "string", "pattern": "^opportunity_[0-9a-f]{20}$" },
    "contract_version": { "const": "airank.opportunity-action.v1" },
    "source_kind": { "type": "string", "enum": ["brand_visibility", "citation_support", "fact_governance", "page_extractability"] },
    "action_type": { "type": "string", "minLength": 1, "maxLength": 96 },
    "status": { "type": "string", "enum": ["open", "in_progress", "evidence_blocked", "verified_not_observed", "waived"] },
    "source_snapshot_id": { "$ref": "#/$defs/snapshot_id" },
    "source_derivation_run_id": { "$ref": "#/$defs/run_id" },
    "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "source_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "latest_snapshot_id": { "$ref": "#/$defs/snapshot_id" },
    "latest_derivation_run_id": { "$ref": "#/$defs/run_id" },
    "latest_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "latest_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "assigned_to": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
    "assigned_at": { "type": ["string", "null"], "format": "date-time" },
    "due_at": { "type": "string", "format": "date-time" },
    "sla_state": { "type": "string", "enum": ["on_track", "due_soon", "overdue", "final"] },
    "action_note": { "type": "string", "minLength": 8, "maxLength": 2000 },
    "verification_run_id": { "oneOf": [{ "$ref": "#/$defs/run_id" }, { "type": "null" }] },
    "verification_basis_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "closure_reason": { "type": ["string", "null"], "minLength": 8, "maxLength": 2000 },
    "effect_claim_allowed": { "const": false },
    "event_count": { "type": "integer", "minimum": 1 },
    "last_event_sha256": { "$ref": "#/$defs/sha256" },
    "created_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "updated_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "type": "integer", "minimum": 1 },
    "completed_at": { "type": ["string", "null"], "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "idempotent_replay": { "type": "boolean" }
  },
  "$defs": {
    "run_id": { "type": "string", "pattern": "^opportunity_run_[0-9a-f]{20}$" },
    "snapshot_id": { "type": "string", "pattern": "^opportunity_snapshot_[0-9a-f]{20}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
