{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_action_directory_binding_put_request.schema.json",
  "title": "Opportunity Action Directory Binding Put Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["external_group_id"],
  "properties": {
    "external_group_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "\\S" },
    "sync_enabled": { "type": "boolean", "default": true },
    "sync_interval_minutes": { "type": "integer", "minimum": 15, "maximum": 10080, "default": 60 },
    "default_priority": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 100 },
    "default_max_active_actions": { "type": "integer", "minimum": 1, "maximum": 100, "default": 5 },
    "default_receives_escalations": { "type": "boolean", "default": true },
    "expected_version": { "type": ["integer", "null"], "minimum": 1 }
  }
}
