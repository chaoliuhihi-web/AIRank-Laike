{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_capacity_calendar_put_request.schema.json",
  "title": "AIRank Opportunity Capacity Calendar Put Request",
  "type": "object",
  "required": ["timezone", "weekly_capacity_hours", "workdays", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "timezone": { "type": "string", "minLength": 1, "maxLength": 64 },
    "weekly_capacity_hours": { "$ref": "#/$defs/positive_decimal" },
    "workdays": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 7 }
    },
    "assumptions": { "type": "string", "minLength": 20, "maxLength": 2000 },
    "expected_version": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "positive_decimal": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0, "maximum": 168 },
        { "type": "string", "pattern": "^(?:0+\\.(?:0*[1-9][0-9]*)|0*(?:[1-9][0-9]?|1[0-5][0-9]|16[0-7])(?:\\.[0-9]+)?|0*168(?:\\.0+)?)$" }
      ]
    }
  }
}
