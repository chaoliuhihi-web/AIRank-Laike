{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_dependency_response.schema.json",
  "title": "AIRank Opportunity Dependency Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": { "$ref": "opportunity_dependency.schema.json" },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "meta": {
      "type": "object", "required": ["trace_id", "request_id"], "additionalProperties": false,
      "properties": { "trace_id": { "type": "string", "minLength": 1 }, "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" } }
    }
  }
}
