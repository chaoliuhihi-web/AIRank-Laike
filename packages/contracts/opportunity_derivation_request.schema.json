{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_derivation_request.schema.json",
  "title": "AIRank Cross-Domain Opportunity Derivation Request",
  "type": "object",
  "required": ["requested_by"],
  "additionalProperties": false,
  "properties": {
    "requested_by": { "type": "string", "minLength": 1, "maxLength": 128 },
    "knowledge_window_days": { "type": "integer", "minimum": 1, "maximum": 365, "default": 30 },
    "as_of": { "type": ["string", "null"], "format": "date-time" }
  }
}
