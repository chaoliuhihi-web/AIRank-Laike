{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/opportunity_execution_plan_put_request.schema.json",
  "title": "AIRank Opportunity Execution Plan Put Request",
  "type": "object",
  "required": ["estimated_effort_hours", "estimated_budget_amount", "assumptions"],
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["draft", "approved"] },
    "estimated_effort_hours": { "oneOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 10000 }, { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]{1,2})?)$" }] },
    "estimated_budget_amount": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 100000000 }, { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]{1,2})?)$" }] },
    "currency": { "const": "CNY" },
    "planned_start_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "planned_due_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
    "assumptions": { "type": "string", "minLength": 8, "maxLength": 4000 },
    "expected_version": { "type": ["integer", "null"], "minimum": 1 }
  }
}
