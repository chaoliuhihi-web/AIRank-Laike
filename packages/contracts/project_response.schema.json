{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/project_response.schema.json",
  "title": "AIRank Project Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "project_id",
        "tenant_id",
        "website_url",
        "brand_name",
        "industry",
        "products",
        "audiences",
        "status",
        "automation_level",
        "source_refs",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "project_id": { "type": "string", "pattern": "^project_[A-Za-z0-9_-]+$" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "website_url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "brand_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "company_name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "industry": { "type": "string", "minLength": 1, "maxLength": 120 },
        "products": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "uniqueItems": true
        },
        "audiences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "uniqueItems": true
        },
        "status": { "type": "string", "enum": ["draft", "seeded", "needs_confirmation", "active", "archived"] },
        "automation_level": { "type": "string", "enum": ["A0", "A1", "A2", "A3"] },
        "source_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/source_ref" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "meta": { "$ref": "#/$defs/response_meta" }
  },
  "$defs": {
    "response_meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    },
    "source_ref": {
      "type": "object",
      "required": ["url", "source_type", "confidence"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "source_type": { "type": "string", "enum": ["owned", "third_party", "community", "unknown"] },
        "captured_at": { "type": "string", "format": "date-time" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
