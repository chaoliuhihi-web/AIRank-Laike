{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/provider_credential_operation_list_response.schema.json",
  "title": "AIRank Provider Credential Operation List Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "operations", "reconciliation_required_count"],
      "properties": {
        "contract_version": { "const": "airank.operation-guard.v1" },
        "operations": {
          "type": "array",
          "items": { "$ref": "provider_credential_operation_response.schema.json#/$defs/operation" }
        },
        "reconciliation_required_count": { "type": "integer", "minimum": 0 }
      }
    },
    "meta": { "$ref": "provider_credential_operation_response.schema.json#/$defs/meta" }
  }
}
