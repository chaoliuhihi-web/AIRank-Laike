{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/provider_credential_response.schema.json",
  "title": "AIRank Provider Credential Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": { "$ref": "#/$defs/credential" },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "probe_level", "model", "endpoint_host", "request_id_present", "provider_request_id_sha256", "duration_ms", "evidence_grade", "verified_at"],
      "properties": {
        "status": { "const": "verified" },
        "probe_level": { "const": "l3_generation" },
        "model": { "type": "string", "minLength": 1 },
        "endpoint_host": { "type": "string", "minLength": 1 },
        "request_id_present": { "type": "boolean" },
        "provider_request_id_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "evidence_grade": { "type": "string", "minLength": 1 },
        "verified_at": { "type": "string", "format": "date-time" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "provider", "label", "route_id", "source", "status", "configured", "credential_id", "credential_version", "secret_mask", "fingerprint_prefix", "encryption_key_id", "fingerprint_key_id", "algorithm", "verification", "rotated_from_id", "created_by", "activated_at", "revoked_at", "latest_event_sha256", "operation_id", "idempotent_replay", "known_limitations"],
      "properties": {
        "contract_version": { "const": "airank.provider-credential-vault.v1" },
        "provider": { "type": "string", "enum": ["doubao", "qianwen", "kimi", "deepseek"] },
        "label": { "type": "string", "minLength": 1 },
        "route_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "source": { "type": "string", "enum": ["vault_active", "vault_revoked", "vault_key_unavailable", "environment_legacy", "unconfigured"] },
        "status": { "type": "string", "enum": ["active", "revoked", "unconfigured", "blocked"] },
        "configured": { "type": "boolean" },
        "credential_id": { "type": ["string", "null"] },
        "credential_version": { "type": "integer", "minimum": 0 },
        "secret_mask": { "type": ["string", "null"], "maxLength": 96 },
        "fingerprint_prefix": { "type": ["string", "null"], "pattern": "^[0-9a-f]{24}$" },
        "encryption_key_id": { "type": ["string", "null"], "maxLength": 64 },
        "fingerprint_key_id": { "type": ["string", "null"], "maxLength": 64 },
        "algorithm": { "type": ["string", "null"], "enum": ["aes-256-gcm", null] },
        "verification": { "oneOf": [{ "$ref": "#/$defs/verification" }, { "type": "null" }] },
        "rotated_from_id": { "type": ["string", "null"] },
        "created_by": { "type": ["string", "null"], "maxLength": 128 },
        "activated_at": { "type": ["string", "null"], "format": "date-time" },
        "revoked_at": { "type": ["string", "null"], "format": "date-time" },
        "latest_event_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "operation_id": { "type": ["string", "null"], "pattern": "^operation_guard_[0-9a-f]{16}$" },
        "idempotent_replay": { "type": "boolean" },
        "known_limitations": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "request_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
