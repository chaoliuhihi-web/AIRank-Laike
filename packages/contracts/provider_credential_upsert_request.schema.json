{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/provider_credential_upsert_request.schema.json",
  "title": "AIRank Provider Credential Upsert Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["secret", "expected_version", "reason", "confirm_billable"],
  "properties": {
    "secret": {
      "type": "string",
      "minLength": 8,
      "maxLength": 16384,
      "writeOnly": true,
      "format": "password"
    },
    "expected_version": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "minLength": 3, "maxLength": 500 },
    "confirm_billable": { "const": true }
  }
}
