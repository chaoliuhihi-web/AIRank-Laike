{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/provider_route_status_response.schema.json",
  "title": "AIRank Provider Route Status Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "window_hours"],
      "properties": {
        "window_hours": { "const": 24 },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "label", "route_id", "endpoint_host", "model", "request_kind", "configured", "enabled", "base_priority", "effective_priority", "control_version", "configuration_fingerprint", "request_count_24h", "success_count_24h", "failure_count_24h", "usage_event_count_24h", "exact_usage_count_24h", "estimated_usage_count_24h", "unknown_usage_count_24h", "known_cost_event_count_24h", "unknown_cost_event_count_24h", "cost_coverage_rate_24h", "aggregate_cost_precision_24h"],
            "properties": {
              "provider": { "type": "string", "enum": ["doubao", "qianwen", "kimi", "deepseek"] },
              "label": { "type": "string", "minLength": 1 },
              "route_id": { "type": "string", "minLength": 1 },
              "endpoint_host": { "type": "string" },
              "model": { "type": "string", "minLength": 1 },
              "request_kind": { "type": "string", "enum": ["chat_completions", "chat_completions_search", "responses_web_search"] },
              "configured": { "type": "boolean" },
              "enabled": { "type": "boolean" },
              "base_priority": { "type": "integer" },
              "effective_priority": { "type": "integer" },
              "priority_override": { "type": "integer" },
              "control_version": { "type": "integer", "minimum": 0 },
              "updated_by": { "type": "string" },
              "reason": { "type": "string" },
              "updated_at": { "type": "string", "format": "date-time" },
              "configuration_fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "request_count_24h": { "type": "integer", "minimum": 0 },
              "success_count_24h": { "type": "integer", "minimum": 0 },
              "failure_count_24h": { "type": "integer", "minimum": 0 },
              "success_rate_24h": { "type": "number", "minimum": 0, "maximum": 1 },
              "average_duration_ms_24h": { "type": "number", "minimum": 0 },
              "total_tokens_24h": { "type": "integer", "minimum": 0 },
              "usage_event_count_24h": { "type": "integer", "minimum": 0 },
              "exact_usage_count_24h": { "type": "integer", "minimum": 0 },
              "estimated_usage_count_24h": { "type": "integer", "minimum": 0 },
              "unknown_usage_count_24h": { "type": "integer", "minimum": 0 },
              "known_cost_event_count_24h": { "type": "integer", "minimum": 0 },
              "unknown_cost_event_count_24h": { "type": "integer", "minimum": 0 },
              "cost_coverage_rate_24h": { "type": "number", "minimum": 0, "maximum": 1 },
              "known_cost_amount_24h": { "type": "string" },
              "known_cost_currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
              "aggregate_cost_precision_24h": { "type": "string", "enum": ["exact", "estimated", "unknown"] }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "request_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
