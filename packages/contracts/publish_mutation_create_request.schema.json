{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/publish_mutation_create_request.schema.json",
  "title": "AIRank governed publication mutation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["action", "idempotency_key", "reason", "requested_by"],
  "properties": {
    "action": {"enum": ["update", "withdraw"]},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 160},
    "reason": {"type": "string", "minLength": 10, "maxLength": 1000},
    "requested_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "replacement_asset_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 64}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "update"}}},
      "then": {
        "required": ["replacement_asset_id"],
        "properties": {"replacement_asset_id": {"type": "string"}}
      }
    },
    {
      "if": {"properties": {"action": {"const": "withdraw"}}},
      "then": {
        "properties": {"replacement_asset_id": {"type": "null"}}
      }
    }
  ]
}
