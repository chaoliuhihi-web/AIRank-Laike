{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/skill_trust_report_response.schema.json",
  "title": "AIRank Skill Trust Report Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "status", "claim_level", "native_runtime_enforcement",
        "limitations", "summary", "installation", "skills", "source_sha256", "report_sha256"
      ],
      "properties": {
        "contract_version": { "const": "airank.skill-trust-report.v1" },
        "status": { "enum": ["passed", "failed"] },
        "claim_level": { "const": "repository_gate_only" },
        "native_runtime_enforcement": { "const": false },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill_count", "execution_allowed_count", "blocked_count", "install_simulation_status"],
          "properties": {
            "skill_count": { "type": "integer", "minimum": 0 },
            "execution_allowed_count": { "type": "integer", "minimum": 0 },
            "blocked_count": { "type": "integer", "minimum": 0 },
            "install_simulation_status": { "enum": ["passed", "failed", "not_run"] }
          }
        },
        "installation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "isolated_from_repository_imports", "skill_count", "package_file_count", "package_manifest_sha256", "failure"],
          "properties": {
            "status": { "enum": ["passed", "failed", "not_run"] },
            "isolated_from_repository_imports": { "type": "boolean" },
            "skill_count": { "type": "integer", "minimum": 0 },
            "package_file_count": { "type": "integer", "minimum": 0 },
            "package_manifest_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "failure": { "type": ["string", "null"] }
          }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillAudit" }
        },
        "source_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry", "registry_schema", "implementation", "trust_engine"],
          "properties": {
            "registry": { "$ref": "#/$defs/sha256" },
            "registry_schema": { "$ref": "#/$defs/sha256" },
            "implementation": { "$ref": "#/$defs/sha256" },
            "trust_engine": { "$ref": "#/$defs/sha256" }
          }
        },
        "report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "meta": { "$ref": "#/$defs/meta" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trace_id", "request_id"],
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    },
    "skillAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_id", "version", "decision", "execution_allowed", "policy_sha256",
        "implementation_sha256", "observed_capabilities", "checks"
      ],
      "properties": {
        "skill_id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "decision": { "enum": ["allow_local_execution", "block_execution"] },
        "execution_allowed": { "type": "boolean" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "implementation_sha256": { "$ref": "#/$defs/sha256" },
        "observed_capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "filesystem", "subprocess", "secret", "dynamic_code"],
          "properties": {
            "network": { "type": "array", "items": { "type": "string" } },
            "filesystem": { "type": "array", "items": { "type": "string" } },
            "subprocess": { "type": "array", "items": { "type": "string" } },
            "secret": { "type": "array", "items": { "type": "string" } },
            "dynamic_code": { "type": "array", "items": { "type": "string" } }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check_id", "status", "details"],
            "properties": {
              "check_id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["passed", "failed"] },
              "details": { "type": "object" }
            }
          }
        }
      }
    }
  }
}
