{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airank.local/contracts/version_response.schema.json",
  "title": "AIRank Version Response",
  "type": "object",
  "required": ["data", "meta"],
  "additionalProperties": false,
  "properties": {
    "data": {
      "type": "object",
      "required": ["service", "version", "api_version", "api_prefix", "commit"],
      "additionalProperties": false,
      "properties": {
        "service": { "type": "string", "const": "airank-api" },
        "version": { "type": "string", "minLength": 1 },
        "api_version": { "type": "string", "const": "v1" },
        "api_prefix": { "type": "string", "const": "/api/v1" },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "meta": {
      "type": "object",
      "required": ["trace_id", "request_id"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "minLength": 1 },
        "request_id": { "type": "string", "pattern": "^req_[0-9a-f]{16}$" }
      }
    }
  }
}
