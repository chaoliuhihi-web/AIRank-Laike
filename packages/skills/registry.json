    {
      "skill_id": "research.intent-miner",
      "version": "1.2.0",
      "category": "research",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "anyOf": [{ "required": ["seed_questions"] }, { "required": ["observed_questions"] }], "properties": { "seed_questions": { "type": "array", "items": { "type": "string" } }, "observed_questions": { "type": "array", "items": { "type": "object", "required": ["question_text", "source_ref", "evidence_grade", "occurrence_count"], "additionalProperties": false, "properties": { "question_text": { "type": "string" }, "source_ref": { "type": "string", "pattern": "^observation:qobatch_[0-9a-f]{20}:qobs_[0-9a-f]{20}$" }, "evidence_grade": { "type": "string", "enum": ["user_provided_snapshot", "connector_verified", "provider_sample_verified"] }, "occurrence_count": { "type": "integer", "minimum": 1 }, "observed_at": { "type": ["string", "null"], "format": "date-time" }, "region": { "type": ["string", "null"] } } } }, "target_names": { "type": "array", "items": { "type": "string" } }, "competitor_names": { "type": "array", "items": { "type": "string" } }, "regions": { "type": "array", "items": { "type": "string" } } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "question_count", "questions"], "properties": { "status": { "type": "string" }, "question_count": { "type": "integer" }, "questions": { "type": "array", "items": { "type": "object", "required": ["question_text", "dedupe_sha256", "question_version_id", "taxonomy_version", "question_type", "cohort_type", "source_kind", "observed_query"] } } } },
      "dependencies": ["airank_domain.question_taxonomy"],
      "provider_requirements": ["none for normalization; provider required for expansion"],
      "evidence_level": ["provided_seed", "template_candidate", "observed_query", "imported"],
      "fact_policy": { "mode": "candidate_only", "rule": "generated intent is not an observed user query; observed_query requires an immutable observation reference and explicit evidence grade" },
      "failure_policy": { "empty_input": "blocked", "duplicates": "retain first with source" },
      "quality_rubric": [{ "key": "deduplication", "threshold": "normalized duplicates removed without inventing volume" }, { "key": "cohort_safety", "threshold": "blind questions contain no target entity" }, { "key": "provenance", "threshold": "every question has taxonomy, version, source kind, and observed-query flag" }],
      "eval_cases": [{ "case_id": "dedupe-and-classify", "input": { "seed_questions": ["价格是多少？", "价格是多少？", "和竞品对比"] }, "expected": { "status": "valid", "question_count": 2 } }],
      "promotion_policy": { "required_suites": ["contract", "holdout", "adversarial"], "minimum_pass_rate": 1.0, "required_evidence": ["observed_query_or_provider_expansion_evidence"] },
      "status": "partial",
      "entrypoint": "airank_skills.core:intent_miner"
    },
