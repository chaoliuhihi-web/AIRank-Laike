                "evidence_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relation_id", "subject_entity_id", "predicate", "object_entity_id", "fact_revision_id", "fact_eligible", "evidence_manifest_sha256"],
              "properties": {
                "relation_id": { "type": "string", "minLength": 1 },
                "subject_entity_id": { "type": "string", "minLength": 1 },
                "predicate": { "type": "string", "minLength": 1 },
                "object_entity_id": { "type": "string", "minLength": 1 },
                "fact_revision_id": { "type": "string", "minLength": 1 },
                "fact_eligible": { "type": "boolean" },
                "evidence_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            }
          }
        }
      },
      "output_schema": {
