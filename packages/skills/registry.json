{
  "registry_version": "1.0.0",
  "skills": [
    {
      "skill_id": "measurement.sample-runner",
      "version": "1.0.0",
      "category": "measurement",
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["questions", "providers", "cohort_type", "repetitions"],
        "properties": {
          "questions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "cohort_type": { "enum": ["blind", "assisted", "comparison", "fact_verification"] },
          "repetitions": { "type": "integer", "minimum": 1, "maximum": 20 },
          "surfaces": { "type": "array", "items": { "enum": ["api", "web", "app", "manual_import"] } }
        }
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": ["status", "tasks"],
        "properties": { "status": { "type": "string" }, "task_count": { "type": "integer" }, "tasks": { "type": "array" }, "failure_code": { "type": "string" } }
      },
      "dependencies": ["airank_domain.measurement"],
      "provider_requirements": ["selected provider and surface must pass health gate before execution"],
      "evidence_level": ["provider_api", "consumer_web", "consumer_app", "manual_import"],
      "fact_policy": { "mode": "no_fact_generation", "rule": "sampling never creates enterprise facts" },
      "failure_policy": { "keep_failed_tasks": true, "keep_blocked_tasks": true, "not_mentioned_is_valid": true },
      "quality_rubric": [{ "key": "independent_sessions", "threshold": "all session_id values unique per planned sample" }],
      "eval_cases": [{ "case_id": "three-repeats", "input": { "questions": ["企业 GEO 工具有哪些？"], "providers": ["qianwen"], "cohort_type": "blind", "repetitions": 3, "surfaces": ["api"] }, "expected": { "status": "planned", "task_count": 3 } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:sample_runner"
    },
    {
      "skill_id": "measurement.answer-parser",
      "version": "1.0.0",
      "category": "measurement",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["answer_text", "brand_name"], "properties": { "answer_text": { "type": "string" }, "brand_name": { "type": "string" }, "aliases": { "type": "array" }, "company_names": { "type": "array" }, "product_names": { "type": "array" } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "brand_mentioned": { "type": "boolean" }, "mention_class": { "type": "string" }, "brand_rank": { "type": ["integer", "null"] }, "confidence": { "type": ["number", "null"] }, "answer_sha256": { "type": "string" }, "entity_mentions": { "type": "array" }, "failure_code": { "type": "string" } } },
      "dependencies": ["airank_domain.measurement"],
      "provider_requirements": [],
      "evidence_level": ["derived_label"],
      "fact_policy": { "mode": "derived_only", "rule": "parser labels never overwrite raw answer" },
      "failure_policy": { "empty_answer": "failed", "not_mentioned": "valid" },
      "quality_rubric": [{ "key": "no_inferred_rank", "threshold": "rank only from explicit ordinal expression" }],
      "eval_cases": [{ "case_id": "valid-not-mentioned", "input": { "answer_text": "可以考虑甲平台和乙平台。", "brand_name": "AIRank" }, "expected": { "status": "valid", "brand_mentioned": false, "mention_class": "not_mentioned", "confidence": null } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:answer_parser"
    },
    {
      "skill_id": "measurement.citation-extractor",
      "version": "1.0.0",
      "category": "measurement",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["native_citations"], "properties": { "native_citations": { "type": "array", "items": { "type": "object" } } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "citation_count", "citations"], "properties": { "status": { "type": "string" }, "citation_count": { "type": "integer" }, "citations": { "type": "array" }, "missing_reason": { "type": ["string", "null"] } } },
      "dependencies": [],
      "provider_requirements": ["provider native citation payload or consumer source panel"],
      "evidence_level": ["provider_native", "consumer_source_panel"],
      "fact_policy": { "mode": "source_only", "rule": "answer text is not a citation" },
      "failure_policy": { "no_citation": "valid_with_missing_reason", "invalid_url": "discard_with_audit" },
      "quality_rubric": [{ "key": "traceable_url", "threshold": "every citation has an http(s) URL from provider evidence" }],
      "eval_cases": [{ "case_id": "dedupe-native", "input": { "native_citations": [{ "url": "https://example.com/a", "title": "A" }, { "url": "https://example.com/a", "title": "A" }] }, "expected": { "status": "valid", "citation_count": 1 } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:citation_extractor"
    },
    {
      "skill_id": "research.intent-miner",
      "version": "1.0.0",
      "category": "research",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["seed_questions"], "properties": { "seed_questions": { "type": "array", "items": { "type": "string" } } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "question_count", "questions"], "properties": { "status": { "type": "string" }, "question_count": { "type": "integer" }, "questions": { "type": "array" } } },
      "dependencies": [],
      "provider_requirements": ["none for normalization; provider required for expansion"],
      "evidence_level": ["provided_seed", "provider_generated_candidate"],
      "fact_policy": { "mode": "candidate_only", "rule": "generated intent is not an observed user query" },
      "failure_policy": { "empty_input": "blocked", "duplicates": "retain first with source" },
      "quality_rubric": [{ "key": "deduplication", "threshold": "normalized duplicates removed without inventing volume" }],
      "eval_cases": [{ "case_id": "dedupe-and-classify", "input": { "seed_questions": ["价格是多少？", "价格是多少？", "和竞品对比"] }, "expected": { "status": "valid", "question_count": 2 } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:intent_miner"
    },
    {
      "skill_id": "knowledge.fact-builder",
      "version": "1.0.0",
      "category": "knowledge",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["source_id", "source_excerpt", "claim"], "properties": { "source_id": { "type": "string" }, "source_excerpt": { "type": "string" }, "claim": { "type": "string" } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status"], "properties": { "status": { "type": "string" }, "fact_text": { "type": "string" }, "source_id": { "type": "string" }, "source_sha256": { "type": "string" }, "source_excerpt": { "type": "string" }, "support_mode": { "type": "string" }, "failure_code": { "type": "string" } } },
      "dependencies": ["KnowledgeSource", "FactRevision"],
      "provider_requirements": [],
      "evidence_level": ["source_excerpt"],
      "fact_policy": { "mode": "pending_review", "rule": "builder cannot approve a fact" },
      "failure_policy": { "missing_source": "blocked", "unsupported_claim": "needs_evidence" },
      "quality_rubric": [{ "key": "source_boundary", "threshold": "claim includes source id, exact excerpt, and content hash" }],
      "eval_cases": [{ "case_id": "exact-support", "input": { "source_id": "source_1", "source_excerpt": "AIRank 于 2026 年上线。", "claim": "AIRank 于 2026 年上线。" }, "expected": { "status": "pending_review", "support_mode": "exact_excerpt" } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:fact_builder"
    },
    {
      "skill_id": "governance.claim-verifier",
      "version": "1.0.0",
      "category": "governance",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["claim", "approved_facts"], "properties": { "claim": { "type": "string" }, "approved_facts": { "type": "array", "items": { "type": "object" } } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "claim", "support_ids"], "properties": { "status": { "type": "string" }, "claim": { "type": "string" }, "support_ids": { "type": "array" } } },
      "dependencies": ["FactAtom", "ClaimSupport"],
      "provider_requirements": [],
      "evidence_level": ["approved_fact_support"],
      "fact_policy": { "mode": "approved_only", "rule": "only approved facts may support publishable claims" },
      "failure_policy": { "no_support": "needs_evidence", "conflict": "blocked_for_human_review" },
      "quality_rubric": [{ "key": "support_coverage", "threshold": "every publishable claim has at least one approved support id" }],
      "eval_cases": [{ "case_id": "approved-exact-fact", "input": { "claim": "支持私有化部署", "approved_facts": [{ "fact_id": "fact_1", "fact_text": "支持私有化部署", "status": "approved" }] }, "expected": { "status": "supported", "support_ids": ["fact_1"] } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:claim_verifier"
    },
    {
      "skill_id": "intervention.page-blueprint",
      "version": "1.0.0",
      "category": "intervention",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["facts"], "properties": { "facts": { "type": "array", "items": { "type": "object" } } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "sections"], "properties": { "status": { "type": "string" }, "sections": { "type": "array" }, "missing_fact_ids": { "type": "array" } } },
      "dependencies": ["FactAtom", "ClaimSupport", "ContentGap"],
      "provider_requirements": [],
      "evidence_level": ["approved_fact_support"],
      "fact_policy": { "mode": "approved_only", "rule": "missing support returns needs_evidence instead of prose" },
      "failure_policy": { "unapproved_fact": "needs_evidence", "empty_fact_set": "needs_evidence" },
      "quality_rubric": [{ "key": "fact_binding", "threshold": "every generated section references approved fact/support ids" }],
      "eval_cases": [{ "case_id": "reject-unapproved", "input": { "facts": [{ "fact_id": "fact_1", "status": "draft", "support_ids": [] }] }, "expected": { "status": "needs_evidence", "sections": [] } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:page_blueprint"
    },
    {
      "skill_id": "delivery.retest-report",
      "version": "1.0.0",
      "category": "delivery",
      "input_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["baseline", "followup"], "properties": { "baseline": { "type": "object" }, "followup": { "type": "object" } } },
      "output_schema": { "$schema": "https://json-schema.org/draft/2020-12/schema", "type": "object", "required": ["status", "conclusion"], "properties": { "status": { "type": "string" }, "mention_rate_delta": { "type": "number" }, "confidence": { "type": "string" }, "conclusion": { "type": "string" }, "failure_code": { "type": "string" } } },
      "dependencies": ["measurement.sample-runner", "CohortMetrics"],
      "provider_requirements": ["same provider/surface/model policy across comparison windows"],
      "evidence_level": ["comparable_observation_windows"],
      "fact_policy": { "mode": "cautious_attribution", "rule": "never claim publication caused recommendation" },
      "failure_policy": { "different_cohort": "blocked", "insufficient_sample": "low_confidence" },
      "quality_rubric": [{ "key": "attribution_language", "threshold": "uses observed/may relate/confidence wording only" }],
      "eval_cases": [{ "case_id": "comparable-low-confidence", "input": { "baseline": { "cohort_type": "blind", "provider_scope": ["qianwen"], "collector_surfaces": ["api"], "question_version": "v1", "mention_rate": 0.2, "valid_sample_count": 3 }, "followup": { "cohort_type": "blind", "provider_scope": ["qianwen"], "collector_surfaces": ["api"], "question_version": "v1", "mention_rate": 0.4, "valid_sample_count": 3 } }, "expected": { "status": "observed", "mention_rate_delta": 0.2, "confidence": "low" } }],
      "status": "partial",
      "entrypoint": "airank_skills.core:retest_report"
    }
  ]
}
