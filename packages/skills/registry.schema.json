{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["registry_version", "skills"],
  "additionalProperties": false,
  "properties": {
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": [
        "skill_id", "version", "category", "input_schema", "output_schema",
        "dependencies", "provider_requirements", "evidence_level", "fact_policy",
        "failure_policy", "quality_rubric", "eval_cases", "promotion_policy", "status", "entrypoint"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_id": { "type": "string", "pattern": "^[a-z]+[a-z0-9-]*\\.[a-z]+[a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "category": { "type": "string", "enum": ["measurement", "research", "knowledge", "intervention", "governance", "delivery"] },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "provider_requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidence_level": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "fact_policy": { "type": "object", "minProperties": 1 },
        "failure_policy": { "type": "object", "minProperties": 1 },
        "quality_rubric": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "eval_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["case_id", "input", "expected"],
            "additionalProperties": false,
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "input": { "type": "object" },
              "expected": { "type": "object" }
            }
          }
        },
        "promotion_policy": {
          "type": "object",
          "required": ["required_suites", "minimum_pass_rate", "required_evidence"],
          "additionalProperties": false,
          "properties": {
            "required_suites": { "type": "array", "minItems": 1, "items": { "enum": ["contract", "holdout", "adversarial"] }, "uniqueItems": true },
            "minimum_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "status": { "type": "string", "enum": ["ready", "partial", "blocked", "disabled", "dev_only"] },
        "entrypoint": { "type": "string", "pattern": "^airank_skills\\.core:[a-z_]+$" }
      }
    }
  }
}
