{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["registry_version", "skills"],
  "additionalProperties": false,
  "properties": {
    "registry_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": [
        "skill_id", "version", "category", "input_schema", "output_schema",
        "dependencies", "provider_requirements", "trust_policy", "evidence_level", "fact_policy",
        "failure_policy", "quality_rubric", "eval_cases", "promotion_policy", "status", "entrypoint"
      ],
      "additionalProperties": false,
      "properties": {
        "skill_id": { "type": "string", "pattern": "^[a-z]+[a-z0-9-]*\\.[a-z]+[a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "category": { "type": "string", "enum": ["measurement", "research", "knowledge", "intervention", "governance", "delivery"] },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "provider_requirements": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "trust_policy": { "$ref": "#/$defs/trustPolicy" },
        "evidence_level": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "fact_policy": { "type": "object", "minProperties": 1 },
        "failure_policy": { "type": "object", "minProperties": 1 },
        "quality_rubric": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "eval_cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["case_id", "input", "expected"],
            "additionalProperties": false,
            "properties": {
              "case_id": { "type": "string", "minLength": 1 },
              "input": { "type": "object" },
              "expected": { "type": "object" }
            }
          }
        },
        "promotion_policy": {
          "type": "object",
          "required": ["required_suites", "minimum_pass_rate", "required_evidence"],
          "additionalProperties": false,
          "properties": {
            "required_suites": { "type": "array", "minItems": 1, "items": { "enum": ["contract", "holdout", "adversarial"] }, "uniqueItems": true },
            "minimum_pass_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          }
        },
        "status": { "type": "string", "enum": ["ready", "partial", "blocked", "disabled", "dev_only"] },
        "entrypoint": { "type": "string", "pattern": "^airank_skills\\.core:[a-z_]+$" }
      }
    },
    "dependencyRef": {
      "type": "object",
      "required": ["dependency", "kind", "target"],
      "additionalProperties": false,
      "properties": {
        "dependency": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["python_module", "python_symbol", "skill_contract"] },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "trustPolicy": {
      "type": "object",
      "required": [
        "runtime_mode", "network_access", "secret_access", "filesystem_access",
        "required_permissions", "dependency_refs", "install_policy"
      ],
      "additionalProperties": false,
      "properties": {
        "runtime_mode": { "const": "deterministic_in_process" },
        "network_access": {
          "type": "object",
          "required": ["mode", "capabilities"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["deny", "gateway_only"] },
            "capabilities": {
              "type": "array",
              "items": { "enum": ["provider_gateway", "crawler_gateway", "object_storage"] },
              "uniqueItems": true
            }
          }
        },
        "secret_access": {
          "type": "object",
          "required": ["mode", "references"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["deny", "reference_only"] },
            "references": {
              "type": "array",
              "items": { "enum": ["provider_credential_ref", "object_storage_credential_ref"] },
              "uniqueItems": true
            }
          }
        },
        "filesystem_access": {
          "type": "object",
          "required": ["mode", "write_scopes"],
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["deny", "content_addressed_store_only"] },
            "write_scopes": {
              "type": "array",
              "items": { "enum": ["evidence_objects", "report_artifacts"] },
              "uniqueItems": true
            }
          }
        },
        "required_permissions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^airank:[a-z0-9-]+:[a-z0-9-]+$" },
          "uniqueItems": true
        },
        "dependency_refs": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyRef" }
        },
        "install_policy": {
          "type": "object",
          "required": ["internal_package_roots", "external_python_dependencies", "allow_repository_imports"],
          "additionalProperties": false,
          "properties": {
            "internal_package_roots": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["airank_skills", "airank_domain", "airank_score"] },
              "uniqueItems": true
            },
            "external_python_dependencies": {
              "type": "array",
              "items": { "enum": ["jsonschema"] },
              "uniqueItems": true
            },
            "allow_repository_imports": { "const": false }
          }
        }
      }
    }
  }
}
